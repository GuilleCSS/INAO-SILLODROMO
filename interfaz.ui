  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #0A0F1C;
}
QWidget {
    font-family: &quot;Segoe UI&quot;;
    color: #E8EEF9;
}
QLabel {
    background: transparent;
}
/* ---------- Paneles ---------- */
QFrame#frameHeader, QFrame#frameFooter, QFrame#frameCamara {
    background-color: #111827;
    border: 1px solid #26324D;
    border-radius: 20px;
}
/* ---------- Encabezado ---------- */
QLabel#lblLogo {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #22D3EE, stop:1 #3B82F6);
    border-radius: 14px;
    color: #FFFFFF;
    font-size: 22px;
    font-weight: 800;
}
QLabel#lblMarca {
    font-size: 24px;
    font-weight: 800;
}
QLabel#lblSubMarca {
    color: #8B9AB8;
    font-size: 14px;
}
QLabel#lblReloj {
    font-size: 28px;
    font-weight: 700;
    padding-left: 8px;
}
/* ---------- Chips de estado ---------- */
QLabel[rol=&quot;chip&quot;] {
    padding: 7px 16px;
    border-radius: 17px;
    font-size: 15px;
    font-weight: 600;
    color: #8B9AB8;
    background-color: #18223A;
    border: 1px solid #26324D;
}
QLabel[rol=&quot;chip&quot;][estado=&quot;ok&quot;] {
    color: #4ADE80;
    background-color: rgba(34, 197, 94, 30);
    border: 1px solid rgba(34, 197, 94, 120);
}
QLabel[rol=&quot;chip&quot;][estado=&quot;move&quot;] {
    color: #FFFFFF;
    background-color: rgba(34, 197, 94, 150);
    border: 1px solid #4ADE80;
}
QLabel[rol=&quot;chip&quot;][estado=&quot;warn&quot;] {
    color: #FBBF24;
    background-color: rgba(245, 158, 11, 30);
    border: 1px solid rgba(245, 158, 11, 120);
}
QLabel[rol=&quot;chip&quot;][estado=&quot;error&quot;] {
    color: #F87171;
    background-color: rgba(239, 68, 68, 30);
    border: 1px solid rgba(239, 68, 68, 120);
}
/* ---------- Títulos de sección ---------- */
QLabel[rol=&quot;seccion&quot;] {
    color: #8B9AB8;
    font-size: 13px;
    font-weight: 800;
}
QLabel[rol=&quot;ayuda&quot;] {
    color: #8B9AB8;
    font-size: 14px;
}
QLabel#lblDireccion {
    font-size: 16px;
    font-weight: 700;
}
/* ---------- Tarjetas de dispositivos ---------- */
QFrame[rol=&quot;tarjeta&quot;] {
    background-color: #111827;
    border: 2px solid #26324D;
    border-radius: 18px;
}
QFrame[rol=&quot;tarjeta&quot;][encendido=&quot;true&quot;] {
    border: 2px solid rgba(34, 197, 94, 170);
}
QLabel[rol=&quot;dispositivo&quot;] {
    font-size: 19px;
    font-weight: 700;
}
QLabel[rol=&quot;pill&quot;] {
    padding: 3px 10px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 700;
    color: #8B9AB8;
    background-color: rgba(100, 116, 139, 40);
    border: 1px solid rgba(100, 116, 139, 110);
}
QLabel[rol=&quot;pill&quot;][estado=&quot;on&quot;] {
    color: #4ADE80;
    background-color: rgba(34, 197, 94, 35);
    border: 1px solid rgba(34, 197, 94, 120);
}
/* ---------- Pie ---------- */
QLabel#label_estado {
    font-size: 17px;
    font-weight: 600;
}
/* ---------- Botón calibrar ---------- */
QPushButton#btnCalibrar {
    padding: 7px 16px;
    border-radius: 17px;
    font-size: 14px;
    font-weight: 700;
    color: #22D3EE;
    background-color: rgba(34, 211, 238, 25);
    border: 1px solid rgba(34, 211, 238, 130);
}
QPushButton#btnCalibrar:hover {
    background-color: rgba(34, 211, 238, 55);
    border: 1px solid #22D3EE;
}
QPushButton#btnCalibrar:pressed {
    background-color: rgba(34, 211, 238, 90);
}
</string>
