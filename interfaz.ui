    <property name="styleSheet">
     <string notr="true">QPushButton {
    background-color: #E63946; /* Color rojo de emergencia */
    color: white;
    border-radius: 150px; /* LA MAGIA: Debe ser exactamente la mitad de tu ancho/alto (200 / 2 = 100) */
    border: 4px solid #900C3F; /* Borde oscuro para dar profundidad */
    font-size: 15px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #FF4D4D; /* Brilla un poco cuando el cursor pasa por encima */
}

QPushButton:pressed {
    background-color: #8B0000; /* Se oscurece al hacer clic */
}</string>
